<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MySql.Data" Version="26.10.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="ProyectoP5.Datos\**\*.cs" />
		<Compile Remove="ProyectoP5.Entidades\**\*.cs" />
		<Compile Remove="ProyectoP5.Negocio\**\*.cs" />
		<Compile Remove="ProyectoP5.Pruebas\**\*.cs" />
		<Compile Remove="ProyectoP5.Presentacion.AssemblyInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="ProyectoP5.Datos\ProyectoP5.Datos.csproj" />
		<ProjectReference Include="ProyectoP5.Entidades\ProyectoP5.Entidades.csproj" />
		<ProjectReference Include="ProyectoP5.Negocio\ProyectoP5.Negocio.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
